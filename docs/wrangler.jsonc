// Cloudflare Workers configuration for the docs: the Sphinx HTML build is
// served as static assets, with no Worker code. The `deploy-docs` job in
// .github/workflows/main.yml deploys it on every push to main.
{
  "name": "impulso-docs",
  "compatibility_date": "2026-09-30",
  // Serve production only on the custom domain, not on workers.dev.
  "workers_dev": false,
  // PR previews: the `preview-docs` job uploads each PR's build as an
  // undeployed version, served at pr-<number>-impulso-docs.<subdomain>.workers.dev.
  // Takes effect at the next `wrangler deploy` (push to main).
  "preview_urls": true,
  // Cloudflare creates the DNS record and certificate for this hostname.
  "routes": [{ "pattern": "impulso.quantclimate.com", "custom_domain": true }],
  "assets": {
    "directory": "./_build/html",
    // Serve every file at exactly the URL Sphinx gives it (/page.html stays
    // /page.html). docs/_redirects maps / and /dir/ to their index.html.
    "html_handling": "none"
  }
}
